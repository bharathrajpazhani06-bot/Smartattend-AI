<!DOCTYPE html>
<html lang="ta">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload Example</title>
</head>
<body>

    <h2>கோப்பைப் பதிவேற்றவும் (Upload File)</h2>
    
    <!-- action="upload.php" என்பது கோப்பைச் செயலாக்கும் சர்வர் பக்கக் குறியீடு -->
    <form action="upload.php" method="POST" enctype="multipart/form-data">
        <label for="fileSelect">கோப்பைத் தேர்ந்தெடுக்கவும்:</label>
        <input type="file" id="fileSelect" name="uploaded_file">
        <br><br>
        <button type="submit">பதிவேற்று (Upload)</button>
    </form>

</body>
</html>
